############################################################################
# Eskemia · Variables del stack de Supabase self-hosted (infra/compose)
#
# Qué es: plantilla del .env que lee docker compose. Se commitea SIN secretos.
# Cómo usarlo: NO copiarlo a mano. Correr desde infra/compose/:
#     sh utils/crear-env.sh
# que copia este archivo a .env, genera todos los secretos (openssl + node)
# y deja .env con permisos 600. El .env nunca va a git.
#
# Cada entorno (desarrollo, producción) tiene SUS PROPIOS secretos.
# Nunca credenciales de producción en una máquina de desarrollo.
#
# Base: .env.example de supabase self-hosted/v0.8.4, recortado (sin Edge
# Functions, Logflare, imgproxy, MinIO ni proxy TLS).
############################################################################


############
# Composición
############

# Archivos de compose que se aplican, separados por ":" (el base siempre primero).
# Desarrollo: base + overlay con Mailpit. Producción: solo docker-compose.yml.
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml


############
# Secretos · los completa utils/crear-env.sh. Dejar vacíos en este archivo.
############

# Contraseña del usuario postgres y de los roles internos de Supabase.
# ATENCIÓN: se graba en volumes/db/data en el PRIMER arranque y no se vuelve a
# leer. Cambiarla después rompe todos los servicios; para rotarla usar
# utils/db-passwd.sh. Generada con: openssl rand -hex 16
POSTGRES_PASSWORD=

# Secreto simétrico HS256 (heredado). Firma ANON_KEY y SERVICE_ROLE_KEY y se
# incluye en los JWKS para seguir verificando tokens viejos.
# Generado con: openssl rand -base64 30
JWT_SECRET=

# Clave API heredada (JWT HS256, rol anon). Pública: puede ir al front.
ANON_KEY=
# Clave API heredada (JWT HS256, rol service_role). Salta RLS: SOLO servidor,
# nunca en el front ni en apps/web.
SERVICE_ROLE_KEY=

# Clave API opaca nueva para el cliente (rol anon). Es la que usa el front.
SUPABASE_PUBLISHABLE_KEY=
# Clave API opaca nueva para el servidor (rol service_role). Nunca en el front.
SUPABASE_SECRET_KEY=

# Arreglo JSON de JWKs de firma (EC P-256 privada + simétrica). Lo usa Auth
# para firmar tokens ES256. Privado.
JWT_KEYS=
# JWKS de verificación (EC pública + simétrica). Lo usan PostgREST, Realtime y
# Storage para validar tokens.
JWT_JWKS=

# JWT ES256 prefirmados que usa solo el gateway internamente para traducir las
# claves opacas. No usarlos en ningún cliente ni servidor.
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=

# Usuario y contraseña de Studio (el gateway pide autenticación básica).
DASHBOARD_USERNAME=eskemia
# Generada con: openssl rand -hex 16
DASHBOARD_PASSWORD=

# Clave de cifrado de Realtime y Supavisor. Mínimo 64 caracteres.
# Generada con: openssl rand -base64 48
SECRET_KEY_BASE=

# Clave de Realtime para campos sensibles del esquema _realtime.
# Exactamente 16 caracteres. Generada con: openssl rand -hex 8
REALTIME_DB_ENC_KEY=

# Clave con que Supavisor cifra su configuración.
# Exactamente 32 caracteres. Generada con: openssl rand -hex 16
VAULT_ENC_KEY=

# Clave con que Studio cifra cadenas de conexión hacia postgres-meta.
# Mínimo 32 caracteres. Generada con: openssl rand -base64 24
PG_META_CRYPTO_KEY=

# Credenciales del endpoint compatible con S3 de Storage.
# Generadas con: openssl rand -hex 16 (id) y openssl rand -hex 32 (secreto)
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=

# Identificador del tenant en Supavisor. Forma parte del usuario de conexión
# al pooler: postgres.<POOLER_TENANT_ID>. Generado con: openssl rand -hex 8
POOLER_TENANT_ID=


############
# URLs
############

# URL pública del gateway (API + Studio). En producción: https://app.<dominio>
SUPABASE_PUBLIC_URL=http://localhost:8000

# URL externa de Auth. Se usa para armar los enlaces de los emails y callbacks.
API_EXTERNAL_URL=http://localhost:8000/auth/v1


############
# Base de datos
############

# Host de Postgres dentro de la red de compose (nombre del servicio).
POSTGRES_HOST=db
# Base de datos de la aplicación.
POSTGRES_DB=postgres
# Puerto de Postgres dentro del contenedor y puerto de Supavisor en modo
# sesión publicado en 127.0.0.1 del host.
POSTGRES_PORT=5432


############
# Pooler (Supavisor)
############

# Puerto del host (127.0.0.1) para conexiones en modo transacción.
POOLER_PROXY_PORT_TRANSACTION=6543
# Conexiones a Postgres que Supavisor abre por pool.
POOLER_DEFAULT_POOL_SIZE=20
# Conexiones de clientes que Supavisor acepta por pool.
POOLER_MAX_CLIENT_CONN=100
# Pool interno de Supavisor para sus propios metadatos.
POOLER_DB_POOL_SIZE=5


############
# Studio
############

# Nombres que muestra Studio (solo cosméticos).
STUDIO_DEFAULT_ORGANIZATION=Eskemia
STUDIO_DEFAULT_PROJECT="Eskemia local"


############
# Auth (GoTrue)
############

# URL del front: destino por defecto de los enlaces de los emails.
# En desarrollo, el servidor de Vite.
SITE_URL=http://localhost:5173
# Otras URLs de redirección permitidas, separadas por coma (admite comodines).
ADDITIONAL_REDIRECT_URLS=http://localhost:5173/**

# Duración del token de acceso en segundos (runbook: 3600 o menos).
JWT_EXPIRY=3600

# Registro público ABIERTO (false = cualquiera puede crear su cuenta).
DISABLE_SIGNUP=false
# Habilita el registro e ingreso con email y contraseña.
ENABLE_EMAIL_SIGNUP=true
# false = la cuenta queda sin confirmar hasta abrir el enlace del email.
ENABLE_EMAIL_AUTOCONFIRM=false
# Usuarios anónimos deshabilitados.
ENABLE_ANONYMOUS_USERS=false
# Registro por teléfono/SMS deshabilitado (no hay proveedor de SMS).
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

# Largo mínimo de contraseña.
PASSWORD_MIN_LENGTH=12
# (Clases de caracteres obligatorias: no se configuran en esta etapa. Si se
# activan, es con GOTRUE_PASSWORD_REQUIRED_CHARACTERS en docker-compose.yml.)

# Rutas que Auth usa dentro de los enlaces de cada tipo de email.
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

## SMTP. En desarrollo apunta a Mailpit (docker-compose.dev.yml), que acepta
## cualquier credencial y no entrega nada afuera. En producción: proveedor real.
# Remitente de los emails de Auth.
SMTP_ADMIN_EMAIL=no-responder@eskemia.test
# Host SMTP (nombre del servicio en compose).
SMTP_HOST=mailpit
# Puerto SMTP.
SMTP_PORT=1025
# Credenciales SMTP. En desarrollo VACÍAS: Auth no intenta autenticarse
# (Go se niega a mandar credenciales sin TLS). En producción, las del proveedor.
SMTP_USER=
SMTP_PASS=
# Nombre visible del remitente.
SMTP_SENDER_NAME=Eskemia


############
# Storage
############

# Con backend de archivos: nombre del directorio dentro de volumes/storage.
GLOBAL_S3_BUCKET=stub
# Región que informa el endpoint S3 (no aplica con backend de archivos).
REGION=stub
# Equivalente al project_ref de la nube, usado por el protocolo S3.
STORAGE_TENANT_ID=stub


############
# API (PostgREST)
############

# Esquemas expuestos por la API REST. Etapa 0: valores del upstream, porque
# todavía no existe el esquema api. En la Etapa 2 pasa a ser solo: api
PGRST_DB_SCHEMAS=public,graphql_public
# Máximo de filas por respuesta.
PGRST_DB_MAX_ROWS=1000
# Esquemas extra en el search_path de cada request.
PGRST_DB_EXTRA_SEARCH_PATH=public


############
# Gateway (Envoy)
############

# Puerto del host (127.0.0.1) donde escucha el gateway: API + Studio.
API_GW_HTTP_PORT=8000
